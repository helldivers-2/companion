---
layout: base.njk
page_id: faq
pagination:
  data: site.locales
  size: 1
  alias: lang
  addAllPagesToCollections: true
permalink: "/{{ lang }}/faq/"
---
<div class="container">
<h1>{{ t.faq.h1 }}</h1>
<div class="faq-grid">
<section class="card prose" aria-labelledby="math-h">
<h2 id="math-h">{{ t.faq.math }}</h2>

<p>{{ t.faq.intro }}</p>

<ul>
  {%- for point in t.faq.points %}
  <li>{{ point }}</li>
  {%- endfor %}
</ul>
</section>

<section class="card prose" aria-labelledby="questions-h">
<h2 id="questions-h">{{ t.faq.questions }}</h2>
{% for qa in t.faq.qa %}
<h3>{{ qa[0] }}</h3>
<p>{{ qa[1] }}</p>
{% endfor %}
<p class="muted">{{ t.faq.source | safe }}</p>
</section>
</div>
</div>

<script type="application/ld+json">
{"@context": "https://schema.org", "@type": "FAQPage", "inLanguage": "{{ lang }}", "mainEntity": [
{%- for qa in t.faq.qa %}
  {"@type": "Question", "name": {{ qa[0] | dump | safe }}, "acceptedAnswer": {"@type": "Answer", "text": {{ qa[1] | dump | safe }}}}{{ "," if not loop.last }}
{%- endfor %}
]}
</script>
