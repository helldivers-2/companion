---
page_id: notfound
# One per language but no translations of each other: no canonical or hreflang, and the language links go to each home page.
standalone: true
permalink: "{{ '' if lang == 'en' else '/' + lang }}/404.html"
eleventyExcludeFromCollections: true
---
<div class="container">
<h1>{{ t.meta.notfound[0] }}</h1>
<div class="card"><p>{{ t.notfound | replace("{home}", "/" + lang + "/") | safe }}</p></div>
</div>
