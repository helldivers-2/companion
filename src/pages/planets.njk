---
page_id: planets
permalink: "/{{ lang }}/planets/"
---
{%- from "item-cells.njk" import imageCredit %}
<div class="container">
<h1>{{ t.nav.planets }}</h1>
<p class="muted hint">{{ t.planets.intro }}</p>
<section class="card" aria-labelledby="all-h">
<h2 id="all-h">{{ t.planets.all }}</h2>
<form class="filters" id="planet-filters" role="search">
  <label>{{ t.planets.search }} <input type="search" name="q" placeholder="{{ t.planets.placeholder }}" autocomplete="off" spellcheck="false"></label>
  <label>{{ t.planets.owner }}
    <select name="owner">
      <option value="">{{ t.planets.anyOwner }}</option>
      {%- for f in labels.factions %}
      <option value="{{ f }}">{{ t.factions[f] }}</option>
      {%- endfor %}
    </select>
  </label>
  <label class="check"><input type="checkbox" name="active"> {{ t.planets.active }}</label>
</form>
<p class="muted" id="planet-count" aria-live="polite"></p>
<div class="table-wrap">
  <table class="planets">
    <thead>
      <tr>
        {%- for col in ["name", "sector", "owner", "biome", "hazards", "players", "liberation"] %}
        <th scope="col"{% if col in ["players", "liberation"] %} class="num"{% elif col != "name" %} class="wide"{% endif %}{% if col != "hazards" %} data-sort="{{ col }}" aria-sort="{{ 'descending' if col == 'players' else 'none' }}"><button type="button">{{ t.planets.cols[col] }}</button>{% else %}>{{ t.planets.cols[col] }}{% endif %}</th>
        {%- endfor %}
      </tr>
    </thead>
    <tbody id="planet-rows"><tr><td colspan="7" class="muted" data-loading>{{ t.planets.loading }}</td></tr></tbody>
  </table>
</div>
{{ imageCredit(planetImages.artists, "planets", t) }}
<script type="application/json" id="planet-images">{{ planetImages.files | dump | replace("<", "\\u003c") | safe }}</script>
</section>
</div>
