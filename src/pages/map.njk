---
page_id: map
permalink: "/{{ lang }}/map/"
---
{%- from "item-cells.njk" import imageCredit %}
<div class="container">
{% include "tabs.njk" %}
<h1>{{ t.map.h1 }}</h1>
<p class="muted hint">{{ t.map.intro }}</p>
<div class="map-layout">
<section class="card map-card" aria-labelledby="map-h">
<h2 class="visually-hidden" id="map-h">{{ t.map.label }}</h2>
<p class="muted" id="map-loading" data-loading>{{ t.map.loading }}</p>
<div class="map-stage">
<div class="map-tools">
  <button type="button" data-zoom="1.5">{% icon "magnifying-glass-plus" %}<span class="visually-hidden">{{ t.map.zoomIn }}</span></button>
  <button type="button" data-zoom="0.6667">{% icon "magnifying-glass-minus" %}<span class="visually-hidden">{{ t.map.zoomOut }}</span></button>
  <button type="button">{% icon "arrows-in" %}<span class="visually-hidden">{{ t.map.reset }}</span></button>
  <input type="search" id="map-find" list="map-names" placeholder="{{ t.map.find }}" aria-label="{{ t.map.find }}" aria-keyshortcuts="/" autocomplete="off" spellcheck="false">
  <datalist id="map-names"></datalist>
</div>
<svg id="map" role="group" aria-label="{{ t.map.label }}" viewBox="0 0 1000 1000">
  {#- the game's sectors, from the Helldivers Wiki (credited below); map.js tints them by owner #}
  <g class="sector-shapes" aria-hidden="true">
    {%- for name, d in sectors.paths %}<path data-sector="{{ name | lower }}" d="{{ d }}"/>{% endfor -%}
    <path class="sector-edge" id="map-sector"/>
  </g>
  <g id="map-layer"></g>
</svg>
</div>
<ul class="legend" aria-label="{{ t.map.legend }}">
  {%- for f in labels.factions %}
  <li class="{{ f | lower }}"><svg viewBox="-14 -14 28 28" aria-hidden="true"><circle class="planet" r="7"/></svg>{{ t.factions[f] }}</li>
  {%- endfor %}
  <li class="terminids"><svg viewBox="-14 -14 28 28" aria-hidden="true"><circle class="mark" r="10"/><circle class="progress" r="10" pathLength="100" stroke-dasharray="60 100" transform="rotate(-90)"/></svg>{{ t.map.liberating }}</li>
  <li class="terminids"><svg viewBox="-14 -14 28 28" aria-hidden="true"><circle class="mark defending" r="10"/></svg>{{ t.map.defending }}</li>
  <li><svg viewBox="-14 -14 28 28" aria-hidden="true"><polygon class="mark order" points="0,-12 12,0 0,12 -12,0"/></svg>{{ t.map.order }}</li>
  <li><svg viewBox="-14 -14 28 28" aria-hidden="true"><path class="lines" d="M-12 8L12 -8"/></svg>{{ t.map.supply }}</li>
  <li><svg viewBox="-14 -14 28 28" aria-hidden="true"><path class="border" d="M-4 -13L2 -2L-3 13"/></svg>{{ t.map.border }}</li>
</ul>
<p class="visually-hidden" id="map-announce" aria-live="polite"></p>
</section>
<div class="map-side">
<section class="card" aria-labelledby="map-detail-h">
<h2 id="map-detail-h">{{ t.map.details }}</h2>
<div id="map-detail"><p class="muted">{{ t.map.hint }}</p></div>
</section>
<section class="card" aria-labelledby="map-fronts-h">
<h2 id="map-fronts-h">{{ t.overview.fronts }}</h2>
<ul class="map-fronts" id="map-fronts"></ul>
</section>
{{ imageCredit(["Betta7776"], "super-earth", t) }}
<p class="muted hint">{{ t.map.sectorsCredit | replace("{wiki}", '<a href="' + sectors.source + '">Helldivers Wiki</a>') | replace("{author}", sectors.author) | replace("{licence}", '<a href="https://www.gnu.org/licenses/gpl.html">GNU GPL</a>') | safe }}</p>
</div>
</div>
</div>
