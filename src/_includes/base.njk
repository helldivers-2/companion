<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {# 'unsafe-inline' styles: progress bars set their width through a style attribute. data: images: the icons are inlined in the stylesheet so they don't flash in. #}
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; connect-src 'self' {{ site.api }}; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'self'">
  <title>{{ title }} · {{ site.name }}</title>
  <meta name="description" content="{{ site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title }} · {{ site.name }}">
  <meta property="og:description" content="{{ site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/img/og.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="A yellow skull next to the words {{ site.name }}, on a dark background">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#1c1917" media="(prefers-color-scheme: dark)">
  <link rel="icon" href="/img/favicon.ico" sizes="48x48">
  <link rel="icon" href="/img/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <link rel="stylesheet" href="/assets/main.css">
  <script src="/assets/main.js" defer></script>
</head>
<body data-page="{{ page_id }}">
  <a class="skip" href="#main">Skip to content</a>
  {# The companion's header: a logo pill and a nav pill on glass, at the top on wide screens and the bottom on phones. #}
  <header class="top">
    <a class="glass logo" href="/"><img src="/img/icon.svg" alt="{{ site.name }} home" width="24" height="24"></a>
    <nav class="glass" aria-label="Main">
      {%- for item in [["/", "Overview", "rocket-launch"], ["/planets/", "Planets", "globe-hemisphere-west"], ["/dispatches/", "Dispatches", "megaphone-simple"], ["/news/", "News", "newspaper"], ["/faq/", "FAQ", "info"]] %}
      <a href="{{ item[0] }}"{% if page.url == item[0] %} aria-current="page"{% endif %}><span class="icon i-{{ item[2] }}" aria-hidden="true"></span><span>{{ item[1] }}</span></a>
      {%- endfor %}
    </nav>
  </header>
  <main id="main">
    <p class="status" id="status" aria-live="off"></p>
    <noscript><p class="notice">This companion loads live war data in your browser, so JavaScript is required.</p></noscript>
    {{ content | safe }}
  </main>
  {# The companion's footer: project line, about and credits beside community links, then the disclaimer. #}
  <footer>
    <div class="footer-main">
      <div>
        <h2>{{ site.name }}</h2>
        <p class="muted">A project by <a href="{{ footer.author.href }}">{{ footer.author.name }}</a>.</p>
      </div>
      <div class="footer-cols">
        <div>
          <p class="muted">A fan-built dashboard for the Helldivers 2 Galactic War, reading live data from the community API every {{ site.refreshSeconds }} s. Built with:</p>
          <ul class="credits">
            {%- for c in footer.credits %}
            <li><a href="{{ c[0] }}"><span class="icon i-{{ c[1] }}" aria-hidden="true"></span>{{ c[2] }}</a></li>
            {%- endfor %}
          </ul>
        </div>
        <div>
          {%- for group in footer.social %}
          <h2 id="footer-{{ loop.index }}">{{ group[0] }}</h2>
          <ul class="social" aria-labelledby="footer-{{ loop.index }}">
            {%- for l in group[1] %}
            <li><a href="{{ l[0] }}" aria-label="{{ l[2] }}"><span class="icon i-{{ l[1] }}" aria-hidden="true"></span></a></li>
            {%- endfor %}
          </ul>
          {%- endfor %}
        </div>
      </div>
    </div>
    <p class="disclaimer">Fan-made. Not affiliated with or endorsed by Arrowhead Game Studios or Sony Interactive Entertainment.</p>
  </footer>
</body>
</html>
