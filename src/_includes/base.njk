<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {# 'unsafe-inline' styles: progress bars set their width through a style attribute #}
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; connect-src 'self' {{ site.api }}; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'self'">
  <title>{{ title }} · {{ site.name }}</title>
  <meta name="description" content="{{ site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title }} · {{ site.name }}">
  <meta property="og:description" content="{{ site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/img/og.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="A yellow skull next to the words {{ site.name }}, on a dark background">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#1c1917" media="(prefers-color-scheme: dark)">
  <link rel="icon" href="/img/favicon.ico" sizes="48x48">
  <link rel="icon" href="/img/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <link rel="stylesheet" href="/assets/main.css">
  <script src="/assets/main.js" defer></script>
</head>
<body data-page="{{ page_id }}">
  <a class="skip" href="#main">Skip to content</a>
  <header class="top">
    <a class="brand" href="/">{{ site.name }}</a>
    <nav aria-label="Main">
      {%- for item in [["/", "Overview", "rocket-launch"], ["/planets/", "Planets", "globe-hemisphere-west"], ["/dispatches/", "Dispatches", "newspaper"]] %}
      <a href="{{ item[0] }}"{% if page.url == item[0] %} aria-current="page"{% endif %}><span class="icon i-{{ item[2] }}" aria-hidden="true"></span>{{ item[1] }}</a>
      {%- endfor %}
    </nav>
    <p class="status" id="status" aria-live="off"></p>
  </header>
  <main id="main">
    <noscript><p class="notice">This companion loads live war data in your browser, so JavaScript is required.</p></noscript>
    {{ content | safe }}
  </main>
  <footer>
    <p>Unofficial fan project, not affiliated with Arrowhead Game Studios. Data from the community <a href="https://helldivers-2.github.io/api/">Helldivers 2 API</a>, refreshed every {{ site.refreshSeconds }} s.</p>
  </footer>
</body>
</html>
