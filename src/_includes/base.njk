<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {# 'unsafe-inline' styles: the map's planet track sets its scale through a style attribute. data: images: the icons are inlined in the stylesheet so they don't flash in. The script hashes are the <script>0</script> below and the theme script. #}
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'sha256-X+zrZv/IbzjZUnhsbWlsecLbwjndTpG0ZynXOif7V+k=' 'sha256-NZx1u9M3JYLtu2Q6RDMr/UzF7BRV/PCq7X0fVJ4CsjM='; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'self'">
  {%- set title = t.meta[page_id][0] %}
  {%- set description = t.meta[page_id][1] %}
  {%- set path = page.url | replace("/" + lang + "/", "/") %}
  <title>{{ title }} · {{ site.name }}</title>
  <meta name="description" content="{{ description }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title }} · {{ site.name }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:locale" content="{{ lang | replace("-", "_") }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/img/og.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ t.layout.ogAlt | replace("{name}", site.name) }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="{{ site.themeColor.light }}" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="{{ site.themeColor.dark }}" media="(prefers-color-scheme: dark)">
  {%- if not standalone %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {%- for l in site.locales %}
  <link rel="alternate" hreflang="{{ l }}" href="{{ site.url }}/{{ l }}{{ path }}">
  {%- endfor %}
  {#- / picks the browser's language, so it is x-default only for the overview; other pages default to English. #}
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ '/' if path == '/' else '/en' + path }}">
  {%- endif %}
  <link rel="icon" href="/img/favicon.ico" sizes="48x48">
  <link rel="icon" href="/img/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  {#- Sets the saved theme before first paint so a forced theme never flashes the other one; main.js wires the header menu to setTheme. #}
  <script>{const r=document.documentElement;let m;window.setTheme=(t,save)=>{if(save)try{t=="system"?localStorage.removeItem("theme"):localStorage.setItem("theme",t)}catch{}r.dataset.theme=t;m?.remove();m=null;if(t!="system"){m=document.createElement("meta");m.name="theme-color";m.content=document.querySelector(`meta[name="theme-color"][media*="${t}"]`).content;document.head.prepend(m)}};let s;try{s=localStorage.getItem("theme")}catch{}setTheme(s=="light"||s=="dark"?s:"system")}</script>
  <link rel="stylesheet" href="/assets/main.css">
  {#- Firefox lays out the body before the stylesheet arrives if anything (often an extension) forces layout early, flashing raw HTML. A script here has to wait for the stylesheet, which holds the body back. #}
  <script>0</script>
</head>
<body data-page="{{ page_id }}">
  <a class="skip" href="#main">{{ t.layout.skip }}</a>
  {# The companion's header: a bar at the top on wide screens, a tab bar at the bottom on phones. #}
  <header class="top">
    <a class="logo" href="/{{ lang }}/"><img src="/img/icon.svg" alt="{{ t.layout.home | replace("{name}", site.name) }}" width="24" height="24"></a>
    <nav aria-label="{{ t.nav.label }}">
      {%- for item in nav %}
      {%- set href = "/" + lang + "/" + item[0] %}
      {#- item[3] lists sub-pages that light up the same entry; item[4] is a class, "wide" keeps it out of the phone tab bar #}
      <a href="{{ href }}"{% if item[4] %} class="{{ item[4] }}"{% endif %}{% if page.url == href or (page.url | replace("/" + lang + "/", "")) in (item[3] or []) %} aria-current="page"{% endif %}>{% icon item[2] %}<span>{{ t.nav[item[1]] }}</span></a>
      {%- endfor %}
    </nav>
    {#- The choices are written once and shown twice: as two dropdowns on wide screens, inside the phone's "More" menu otherwise. #}
    {%- set langItems %}
          {%- for l in site.locales %}
          <a role="menuitem" href="/{{ l }}{{ '/' if standalone else path }}" hreflang="{{ l }}" lang="{{ l }}"{% if l == lang %} aria-current="page"{% endif %}>{{ i18n[l].name }}</a>
          {%- endfor %}
    {%- endset %}
    {%- set themeItems %}
          {%- for v in ["system", "light", "dark"] %}
          <button type="button" class="ghost" role="menuitem" value="{{ v }}"{% if v == "system" %} aria-current="true"{% endif %}>{{ t.theme[v] }}</button>
          {%- endfor %}
    {%- endset %}
    {#- Theme choices stay hidden until main.js runs: without JavaScript the choice can't apply, so it isn't offered. #}
    <ot-dropdown class="wide">
      <button type="button" class="ghost" popovertarget="lang-menu" aria-label="{{ t.layout.language }}" aria-expanded="false">{% icon "translate" %}</button>
      <div popover id="lang-menu" role="menu" aria-label="{{ t.layout.language }}">{{ langItems | safe }}
      </div>
    </ot-dropdown>
    <ot-dropdown class="wide theme-choice" hidden>
      <button type="button" class="ghost" popovertarget="theme-menu" aria-label="{{ t.theme.label }}" aria-expanded="false">{% icon "circle-half" %}</button>
      <div popover id="theme-menu" role="menu" aria-label="{{ t.theme.label }}">{{ themeItems | safe }}
      </div>
    </ot-dropdown>
    <ot-dropdown class="narrow">
      <button type="button" class="ghost" popovertarget="menu" aria-label="{{ t.layout.more }}" aria-expanded="false">{% icon "dots-three-vertical" %}</button>
      <div popover id="menu" role="menu" aria-label="{{ t.layout.more }}">
        <a role="menuitem" href="/{{ lang }}/faq/"{% if page_id == "faq" %} aria-current="page"{% endif %}>{% icon "info" %} {{ t.nav.faq }}</a>
        <div role="group" aria-labelledby="menu-lang">
          <hr>
          <p class="menu-label" id="menu-lang">{{ t.layout.language }}</p>{{ langItems | safe }}
        </div>
        <div role="group" class="theme-choice" aria-labelledby="menu-theme" hidden>
          <hr>
          <p class="menu-label" id="menu-theme">{{ t.theme.label }}</p>{{ themeItems | safe }}
        </div>
      </div>
    </ot-dropdown>
  </header>
  <main id="main">
    <div class="status-row">
      {%- if page_id == "overview" %}<p id="online"></p>{% endif %}
      <p class="status" id="status" aria-live="off"></p>
    </div>
    <noscript><p role="alert">{% icon "info" %} {{ t.layout.noscript }}</p></noscript>
    {{ content | safe }}
  </main>
  {# The companion's footer: project line, about and credits beside community links, then the disclaimer. #}
  <footer>
    <div class="footer-main">
      <div>
        <h2>{{ site.name }}</h2>
        <p class="muted">{{ t.layout.by | replace("{author}", '<a href="' + footer.author.href + '">' + footer.author.name + "</a>") | safe }}</p>
      </div>
      <div class="footer-cols">
        <div>
          <p class="muted">{{ t.layout.about | replace("{s}", site.refreshSeconds) }}</p>
          <ul class="credits">
            {%- for c in footer.credits %}
            <li><a href="{{ c[0] }}">{{ c[1] }}</a></li>
            {%- endfor %}
          </ul>
        </div>
        <div>
          {#- Brand names are not translated, so a link label is used as-is unless it is a key in layout.links. #}
          {%- for group in footer.social %}
          <h2 id="footer-{{ loop.index }}">{{ t.layout.links[group[0]] }}</h2>
          <ul class="social" aria-labelledby="footer-{{ loop.index }}">
            {%- for l in group[1] %}
            <li><a href="{{ l[0] }}" aria-label="{{ t.layout.links[l[2]] or l[2] }}">{% icon l[1] %}</a></li>
            {%- endfor %}
          </ul>
          {%- endfor %}
        </div>
      </div>
    </div>
    <p class="disclaimer">{{ t.layout.disclaimer }}</p>
  </footer>
  {#- \u003c keeps a "</script>" inside a string from closing the tag. #}
  <script type="application/json" id="strings">{{ strings | dump | replace("<", "\\u003c") | safe }}</script>
  {#- Not deferred: it must run before the first paint, so cached data shows at once instead of the "Loading…" placeholder flashing first. #}
  <script src="/assets/main.js"></script>
</body>
</html>
