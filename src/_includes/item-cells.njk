{#- Cells shared by the item database and the shop. Macros see no template data, so lang and t come in as arguments. #}
{% macro dash(t) %}<span class="muted" aria-hidden="true">–</span><span class="visually-hidden">{{ t.items.unlisted }}</span>{% endmacro %}

{% macro unlock(s, t, lang) -%}
{%- if not s %}{{ dash(t) }}
{%- elif s.kind == "superstore" %}<a href="/{{ lang }}/shop/">{{ t.items.superstore }}</a>
{%- elif s.kind == "warbond" %}<span lang="en">{{ s.name }}</span>{% if s.page %} <span class="muted">{{ t.items.page | replace("{n}", s.page) }}</span>{% endif %}
{%- else %}<span lang="en">{{ s.name }}</span>
{%- endif %}
{%- endmacro %}

{% macro price(c, t) -%}
{%- if c %}{{ c.amount }} {{ t.items.currency[c.currency] }}{% else %}{{ dash(t) }}{% endif %}
{%- endmacro %}

{% macro credit(items, t) -%}
<p class="muted hint">{{ t.items.credit | replace("{source}", '<a href="' + items.source.url + '">' + items.source.name + '</a>') | replace("{licence}", '<a href="' + items.source.licenceUrl + '">' + items.source.licence + '</a>') | replace("{date}", items.fetched) | safe }}</p>
{%- endmacro %}
