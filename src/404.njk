---
layout: base.njk
page_id: notfound
pagination:
  data: site.locales
  size: 1
  alias: lang
  addAllPagesToCollections: true
permalink: "{{ '' if lang == 'en' else '/' + lang }}/404.html"
eleventyExcludeFromCollections: true
---
<div class="container">
<h1>{{ t.titles.notfound }}</h1>
<div class="card"><p>{{ t.notfound | replace("{home}", "/" + lang + "/") | safe }}</p></div>
</div>
