{
  // Static assets, plus worker.js for /api/*. Cloudflare reads _site/_redirects and serves _site/404.html for unknown paths.
  // The helldivers.michi.onl custom domain is attached in the dashboard, not here, because the CI token
  // is scoped to this one Worker and per-Worker tokens can't manage custom domains.
  "name": "helldivers-companion",
  "compatibility_date": "2026-11-16",
  "main": "worker.js",
  "assets": { "directory": "_site", "not_found_handling": "404-page", "run_worker_first": ["/api/*"] },
  // The self-hosted API's tunnel hostname. ACCESS_CLIENT_ID and ACCESS_CLIENT_SECRET are Worker secrets (wrangler secret put).
  "vars": { "API_ORIGIN": "https://helldivers-api.michi.onl" },
  // wrangler re-enables the workers.dev and preview URLs on every deploy unless these say otherwise
  "workers_dev": false,
  "preview_urls": false
}
