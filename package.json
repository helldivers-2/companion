{
  "name": "helldivers-companion",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/js/main.js --bundle --minify --outfile=_site/assets/main.js && sass --style=compressed --no-source-map --load-path=node_modules src/scss/main.scss _site/assets/main.css && eleventy",
    "dev": "esbuild src/js/main.js --bundle --outfile=_site/assets/main.js --watch=forever & sass --watch --no-source-map --load-path=node_modules src/scss/main.scss _site/assets/main.css & eleventy --serve",
    "test": "node --test"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "esbuild": "^0.28.2",
    "sass": "^1.108.2"
  }
}
